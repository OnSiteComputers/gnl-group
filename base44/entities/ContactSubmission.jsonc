{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "firm_name": {
      "type": "string",
      "title": "Firm Name"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "practice_area": {
      "type": "string",
      "title": "Practice Area"
    },
    "service_interest": {
      "type": "string",
      "title": "Service Interest"
    },
    "growth_goal": {
      "type": "string",
      "title": "Growth Goal"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "firm_name",
    "contact_name",
    "email",
    "practice_area"
  ]
}